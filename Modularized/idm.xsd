<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
	xmlns:idm="https://standards.iso.org/iso/29481/-3/ed-2/en"
	targetNamespace="https://standards.iso.org/iso/29481/-3/ed-2/en"
	elementFormDefault="qualified">
	<xs:include schemaLocation="specId.xsd"/>
	<xs:include schemaLocation="authoring.xsd"/>
	<xs:include schemaLocation="uc.xsd"/>
	<xs:include schemaLocation="businessContextMap.xsd"/>
	<xs:include schemaLocation="er.xsd"/>
	<xs:element name="idm">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="idm:specId" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="idm:authoring" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="idm:uc" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="idm:businessContextMap" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="idm:er" minOccurs="0" maxOccurs="1"/>
				<xs:element name="subIdm" minOccurs="0" maxOccurs="unbounded">
					<xs:complexType>
						<xs:sequence>
							<xs:element ref="idm:idm"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
		<!-- Cross-element identity constraint: er/constraint/associatedBusinessRule/@ref references uc/businessRule/@id.
		     Revision 11: covers constraints in the top-level ER and in sub-ERs up to 5 levels deep
		     (XSD 1.0 selectors cannot express arbitrary depth without also reaching into subIdm,
		     whose business rules are scoped to the sub-IDM). Deeper nesting is checked by the application. -->
		<xs:key name="key_businessRuleId">
			<xs:selector xpath="idm:uc/idm:businessRule"/>
			<xs:field xpath="@id"/>
		</xs:key>
		<xs:keyref name="keyref_associatedBusinessRuleRef" refer="idm:key_businessRuleId">
			<xs:selector xpath="idm:er/idm:constraint/idm:associatedBusinessRule | idm:er/idm:subEr/idm:er/idm:constraint/idm:associatedBusinessRule | idm:er/idm:subEr/idm:er/idm:subEr/idm:er/idm:constraint/idm:associatedBusinessRule | idm:er/idm:subEr/idm:er/idm:subEr/idm:er/idm:subEr/idm:er/idm:constraint/idm:associatedBusinessRule | idm:er/idm:subEr/idm:er/idm:subEr/idm:er/idm:subEr/idm:er/idm:subEr/idm:er/idm:constraint/idm:associatedBusinessRule | idm:er/idm:subEr/idm:er/idm:subEr/idm:er/idm:subEr/idm:er/idm:subEr/idm:er/idm:subEr/idm:er/idm:constraint/idm:associatedBusinessRule"/>
			<xs:field xpath="@ref"/>
		</xs:keyref>
	</xs:element>
</xs:schema>
